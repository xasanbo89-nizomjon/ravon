{
  "entities": {
    "StoreSyncState": {
      "title": "StoreSyncState",
      "description": "Real-time synchronized store state across phone and desktop devices.",
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "description": "Synchronized store products list"
        },
        "orders": {
          "type": "array",
          "description": "Synchronized customer orders list"
        },
        "siteSettings": {
          "type": "object",
          "description": "Store settings and contact details"
        },
        "announcementBanner": {
          "type": "object",
          "description": "Top announcement banner configuration"
        },
        "carModels": {
          "type": "array",
          "description": "Supported car models filter list"
        },
        "categories": {
          "type": "array",
          "description": "Supported product categories list"
        },
        "promoCodes": {
          "type": "array",
          "description": "Active and inactive promo codes"
        },
        "reviews": {
          "type": "array",
          "description": "Customer product reviews and ratings"
        },
        "deletedProductIds": {
          "type": "array",
          "description": "IDs of products explicitly deleted by admin"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds of last update"
        }
      },
      "required": ["updatedAt"]
    },
    "ProductDocument": {
      "title": "ProductDocument",
      "description": "Individual product record stored in global Firestore catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bazaarName": { "type": "string" },
        "category": { "type": "string" },
        "carModels": { "type": "array" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string" },
        "inStock": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "specs": { "type": "array" },
        "tags": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    }
  },
  "firestore": {
    "/ravon_sync/{docId}": {
      "schema": "StoreSyncState",
      "description": "Main real-time synchronization document for Ravon Auto Tuning"
    },
    "/ravon_products/{productId}": {
      "schema": "ProductDocument",
      "description": "Global real-time product catalog collection for Ravon Auto Tuning"
    }
  }
}
