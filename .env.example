# API_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# You can also obtain an API key from Google AI Studio: https://aistudio.google.com/
API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ravon-alpha.vercel.app/"

# Telegram Bot configurations (optional)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_ADMIN_CHAT_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID"

# Supabase Realtime & Database Sync (optional)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
